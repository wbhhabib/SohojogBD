generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DONOR
  CREATOR
  ADMIN
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  SUSPENDED
}

enum DonationStatus {
  PENDING
  COMPLETED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  VALID
  FAILED
  CANCELLED
  REFUNDED
}

enum NotifType {
  DONATION
  MILESTONE
  COMMENT
  SYSTEM
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum IdentityType {
  NID
  BIRTH_CERTIFICATE
}

enum PoolStatus {
  OPEN
  TARGET_REACHED
  CLOSED
  CANCELLED
}

model User {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  password         String
  role             Role           @default(DONOR)
  avatar           String?
  phone            String?
  address          String?
  respLat          Float?
  respLng          Float?
  respRadiusKm     Int?           @default(5)
  pushEnabled      Boolean        @default(false)
  isVerified       Boolean        @default(false)
  isBanned         Boolean        @default(false)
  verifyToken      String?
  resetToken       String?
  resetTokenExpiry DateTime?

  // --- Common/core verification fields ---
  dateOfBirth              DateTime?
  identityType             IdentityType?
  identityNumber           String?
  identityDocPicture       String?
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?
  verificationStatus       VerificationStatus @default(NOT_SUBMITTED)
  verificationNote         String?

  // --- Contextual fields (action-specific, but stored on User) ---
  sex                 String?
  occupation          String?
  educationLevel      String?
  institution         String?
  bloodGroup          String?
  skill               String?
  division            String?
  district            String?
  upazila             String?
  hasTraining         Boolean?  @default(false)
  trainingCertificate String?
  isStudent           Boolean?  @default(false)
  studentIdCard       String?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  campaigns        Campaign[]
  donations        Donation[]
  comments         Comment[]
  notifications    Notification[]
  payments         Payment[]
  reports    Report[]
  plantListings    PlantListing[]
  plantClaims      PlantClaim[]
  organizations    Organization[]
  volunteerRequests VolunteerRequest[]
  orgVerificationLogs OrgVerificationLog[] @relation("OrgVerificationAdmin")
  sosRequests         SOSRequest[]
  sosResponses        SOSResponse[]
  pushSubscriptions   PushSubscription[]
  wholesalePools      WholesalePool[]
  poolParticipations  PoolParticipant[]
}
model Campaign {
  id              String           @id @default(cuid())
  title           String
  slug            String           @unique
  description     String
  story           String           @db.Text
  goalAmount      Int
  raisedAmount    Int              @default(0)
  donorCount      Int              @default(0)
  category        String
  status          CampaignStatus   @default(DRAFT)
  images          String[]
  beneficiaryName String
  beneficiaryInfo String
  deadline        DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  creatorId       String
  creator         User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  donations       Donation[]
  comments        Comment[]
  updates         CampaignUpdate[]
  notifications   Notification[]
  reports    Report[]

  @@index([creatorId])
  @@index([status])
  @@index([category])
  @@index([slug])
}

model Donation {
  id          String         @id @default(cuid())
  amount      Int
  message     String?
  isAnonymous Boolean        @default(false)
  status      DonationStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  donorId     String
  donor       User           @relation(fields: [donorId], references: [id], onDelete: Cascade)
  campaignId  String
  campaign    Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  payment     Payment?

  @@index([donorId])
  @@index([campaignId])
  @@index([status])
}

model Payment {
  id              String        @id @default(cuid())
  tranId          String        @unique
  valId           String?
  amount          Int
  currency        String        @default("BDT")
  status          PaymentStatus @default(PENDING)
  gatewayResponse Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  donorId         String
  donor           User          @relation(fields: [donorId], references: [id], onDelete: Cascade)
  donationId      String        @unique
  donation        Donation      @relation(fields: [donationId], references: [id], onDelete: Cascade)
}

model Comment {
  id         String   @id @default(cuid())
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model CampaignUpdate {
  id         String   @id @default(cuid())
  title      String
  content    String   @db.Text
  createdAt  DateTime @default(now())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String    @id @default(cuid())
  type       NotifType
  title      String
  message    String
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum ReportReason {
  FAKE_CAMPAIGN
  SPAM
  MISLEADING
  INAPPROPRIATE
}

model Report {
  id         String       @id @default(cuid())
  reason     ReportReason
  status     ReportStatus @default(PENDING)
  note       String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([reporterId])
  @@index([status])
}
enum PlantListingStatus {
  AVAILABLE
  CLAIMED
  COMPLETED
  CANCELLED
}

enum PlantClaimStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model PlantListing {
  id           String             @id @default(cuid())
  title        String
  slug         String             @unique
  description  String
  plantType    String
  quantity     Int                @default(1)
  images       String[]
  location     String
  contactPhone String?
  status       PlantListingStatus @default(AVAILABLE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  ownerId      String
  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  claims       PlantClaim[]

  @@index([ownerId])
  @@index([status])
  @@index([plantType])
  @@index([slug])
}

model PlantClaim {
  id         String            @id @default(cuid())
  message    String?
  quantity   Int               @default(1)
  status     PlantClaimStatus  @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  claimantId String
  claimant   User              @relation(fields: [claimantId], references: [id], onDelete: Cascade)
  listingId  String
  listing    PlantListing      @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([claimantId])
  @@index([status])
}

model WholesalePool {
  id                 String            @id @default(cuid())
  title              String
  slug               String            @unique
  description        String
  category           String
  unit               String
  targetQuantity     Int
  minJoinQuantity    Int               @default(1)
  pricePerUnit       Int
  marketPricePerUnit Int?
  division           String
  district           String
  upazila            String
  location           String
  contactPhone       String
  groupLink          String?
  images             String[]
  status             PoolStatus        @default(OPEN)
  deadline           DateTime
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  ownerId            String
  owner              User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  participants       PoolParticipant[]

  @@index([ownerId])
  @@index([status])
  @@index([category])
  @@index([division])
  @@index([district])
  @@index([upazila])
  @@index([slug])
}

model PoolParticipant {
  id            String        @id @default(cuid())
  quantity      Int
  note          String?
  createdAt     DateTime      @default(now())
  poolId        String
  pool          WholesalePool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  participantId String
  participant   User          @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([poolId, participantId])
  @@index([poolId])
  @@index([participantId])
}

enum VolunteerRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum OrgCategory {
  REGISTERED
  TEAM
}

enum OrgVerificationStatus {
  PENDING
  UNDER_REVIEW
  MORE_INFO_REQUIRED
  APPROVED
  REJECTED
  SUSPENDED
  EXPIRED
}

enum InstitutionAffiliation {
  YES
  NO
  NOT_APPLICABLE
}

model Organization {
  id               String                 @id @default(cuid())
  name             String
  slug             String                 @unique
  description      String
  category         OrgCategory
  orgType          String
  orgTypeOther     String?
  establishedYear  Int?
  logo             String?
  coverImage       String?
  contactPhone     String
  contactEmail     String?
  website          String?
  facebookPage     String?
  otherSocialLinks String?

  division     String?
  district     String?
  upazila      String?
  fullAddress  String
  postalCode   String?
  latitude     Float?
  longitude    Float?

  status       OrgVerificationStatus @default(PENDING)
  adminNote    String?
  rejectReason String?

  declarationAccepted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  areasOfWork    AreaOfWork[]
  registration   OrgRegistration?
  teamEvidence   OrgTeamEvidence?
  institution    OrgInstitution?
  representative OrgRepresentative?
  requests       VolunteerRequest[]
  updates        OrgUpdate[]
  verificationLogs OrgVerificationLog[]

  @@index([ownerId])
  @@index([category])
  @@index([status])
  @@index([slug])
}

model AreaOfWork {
  id             String       @id @default(cuid())
  area           String
  areaOther      String?
  description    String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ── Registered Organization only ──────────────────────────────────────────
model OrgRegistration {
  id                    String       @id @default(cuid())
  registrationAuthority String
  authorityOther        String?
  registrationNumber    String
  registrationDate      DateTime
  expiryDate            DateTime?
  certificateUrl        String?
  organizationId         String       @unique
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ── Volunteer Team / Community Group only ─────────────────────────────────
model OrgTeamEvidence {
  id                    String       @id @default(cuid())
  pastActivities        String?
  activityCount         Int?
  volunteerCountApprox  Int?
  recentActivity        String?
  photos                String[]
  activityReportUrl     String?
  facebookPageUrl       String?
  previousCampaignLinks String[]
  supportingDocUrl      String?
  organizationId        String       @unique
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ── School / College / University groups only ─────────────────────────────
model OrgInstitution {
  id                  String                  @id @default(cuid())
  institutionName     String
  institutionType     String
  department          String?
  clubName            String?
  advisorName         String?
  advisorContact      String?
  affiliated          InstitutionAffiliation  @default(NOT_APPLICABLE)
  authorizationDocUrl String?
  organizationId      String                  @unique
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrgRepresentative {
  id                  String       @id @default(cuid())
  fullName            String
  designation         String
  designationOther    String?
  mobile              String
  email                String?
  nidNumber           String
  nidDocUrl           String?
  authorizationDocUrl String?
  organizationId      String       @unique
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrgVerificationLog {
  id             String                 @id @default(cuid())
  oldStatus      OrgVerificationStatus?
  newStatus      OrgVerificationStatus
  reason         String?
  createdAt      DateTime               @default(now())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adminId        String
  admin          User                   @relation("OrgVerificationAdmin", fields: [adminId], references: [id])

  @@index([organizationId])
}

model VolunteerRequest {
  id             String                 @id @default(cuid())
  message        String?
  status         VolunteerRequestStatus @default(PENDING)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  volunteerId    String
  volunteer      User                   @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([volunteerId])
  @@index([status])
}

model OrgUpdate {
  id             String       @id @default(cuid())
  title          String
  content        String       @db.Text
  images         String[]
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

enum SOSStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
}

model SOSRequest {
  id          String       @id @default(cuid())
  message     String
  latitude    Float
  longitude   Float
  address     String?
  status      SOSStatus    @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  requesterId String
  requester   User         @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  responses   SOSResponse[]

  @@index([requesterId])
  @@index([status])
}

model SOSResponse {
  id           String     @id @default(cuid())
  status       String     @default("ACKNOWLEDGED") // ACKNOWLEDGED | ON_THE_WAY | ARRIVED
  createdAt    DateTime   @default(now())
  sosRequestId String
  sosRequest   SOSRequest @relation(fields: [sosRequestId], references: [id], onDelete: Cascade)
  responderId  String
  responder    User       @relation(fields: [responderId], references: [id], onDelete: Cascade)

  @@unique([sosRequestId, responderId])
  @@index([sosRequestId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}