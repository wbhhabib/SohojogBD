server/.env.example# ══════════════════════════════════════════════════════════════════════════════
# FundRaise BD — Production Environment Template
# ══════════════════════════════════════════════════════════════════════════════
# INSTRUCTIONS:
#  1. Copy this file to .env in your production server
#  2. Fill in ALL values marked with <REPLACE_...>
#  3. Never commit the filled-in .env to version control
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=require"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<REPLACE_WITH_64_CHAR_RANDOM_HEX>
JWT_REFRESH_SECRET=<REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_HEX>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── URLs ──────────────────────────────────────────────────────────────────────
SERVER_URL=https://api.yourdomain.com
CLIENT_URL=https://yourdomain.com

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<YOUR_PRODUCTION_EMAIL@gmail.com>
SMTP_PASS=<YOUR_GMAIL_APP_PASSWORD>
FROM_EMAIL=<YOUR_PRODUCTION_EMAIL@gmail.com>

# ── SSLCommerz ────────────────────────────────────────────────────────────────
# ⚠️  Get LIVE credentials from: https://dashboard.sslcommerz.com → Settings → API Credentials
# sandbox credentials (testbox/test) production-এ কাজ করবে না!
SSLCOMMERZ_STORE_ID=<YOUR_LIVE_STORE_ID>
SSLCOMMERZ_STORE_PASS=<YOUR_LIVE_STORE_PASSWORD>
# isLive — payment.service.ts-এ NODE_ENV=production হলে automatically true হয়

# ── File Upload ───────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Redirect URI: https://api.yourdomain.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>